{
  "name": "sushizanmai",
  "version": "1.0.0",
  "private": true,
  "description": "Visualization of my Sushida (typing game) score records",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/struuuuggle/sushizanmai.git"
  },
  "homepage": "https://struuuuggle.github.io/sushizanmai/",
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -i ./css/input.css -o ./css/style.css --minify",
    "build:js": "mkdir -p js/vendor && cp node_modules/d3/dist/d3.min.js js/vendor/d3.min.js",
    "watch:css": "tailwindcss -i ./css/input.css -o ./css/style.css --watch",
    "dev": "http-server -c-1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "http-server": "^14.1.1",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "d3": "^7.9.0"
  }
}
