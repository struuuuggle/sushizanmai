{
  "name": "sushizanmai",
  "version": "1.0.0",
  "private": true,
  "description": "Visualization of my Sushida (typing game) score records",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/struuuuggle/sushizanmai.git"
  },
  "homepage": "https://struuuuggle.github.io/sushizanmai/",
  "scripts": {
    "build:css": "tailwindcss -i ./css/input.css -o ./css/style.css --minify",
    "watch:css": "tailwindcss -i ./css/input.css -o ./css/style.css --watch",
    "serve": "http-server -p 8000 -c-1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "http-server": "^14.1.1",
    "tailwindcss": "^4.3.3"
  }
}
